<?xml version="1.0" encoding="utf-8"?>
<extension type="template" client="site" method="upgrade">
	<name>xclusive</name>
	<version>1.0.7</version>
	<creationDate>2026-11</creationDate>
	<author>Herman Peeren</author>
	<copyright>(C) 2026 Herman Peeren. Theme CSS based on Joostrap Portfolio, (C) 2005 - 2014 Joostrap.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<description>TPL_XCLUSIVE_XML_DESCRIPTION</description>
	<parent>cassiopeia</parent>
	<files>
		<filename>error.php</filename>
		<filename>error-content.php</filename>
		<filename>index.php</filename>
		<filename>joomla.asset.json</filename>
		<filename>templateDetails.xml</filename>
		<folder>html</folder>
	</files>
	<media destination="templates/site/xclusive" folder="media">
		<folder>css</folder>
		<folder>images</folder>
		<folder>js</folder>
	</media>
	<positions>
		<!-- The positions of the Joomla 3 template xclusive-joostrap, so module assignments stay valid -->
		<position>mob-menu-above</position>
		<position>menu</position>
		<position>mob-menu-below</position>
		<position>carousel</position>
		<position>strapline</position>
		<position>top</position>
		<position>middle</position>
		<position>top-article</position>
		<position>left</position>
		<position>left_menu</position>
		<position>right</position>
		<position>bottom1</position>
		<position>bottom2</position>
		<position>footer1</position>
		<position>ondermenu1</position>
		<position>ondermenu2</position>
		<position>ondermenu3</position>
		<position>ondermenu4</position>
		<position>footer2</position>
		<position>debug</position>
	</positions>
	<languages folder="language">
		<language tag="en-GB">en-GB/tpl_xclusive.ini</language>
		<language tag="en-GB">en-GB/tpl_xclusive.sys.ini</language>
		<language tag="nl-NL">nl-NL/tpl_xclusive.ini</language>
		<language tag="nl-NL">nl-NL/tpl_xclusive.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="logo" label="TPL_XCLUSIVE_FIELDSET_LOGO">
				<field
					name="logoFile"
					type="media"
					default="images/Logo/logo-white-transparant-min.png"
					label="TPL_XCLUSIVE_LOGO_LABEL"
				/>
				<field
					name="sitetitle"
					type="text"
					default=""
					label="TPL_XCLUSIVE_SITETITLE_LABEL"
					filter="string"
					showon="logoFile:"
				/>
				<field
					name="sitedescription"
					type="text"
					default=""
					label="TPL_XCLUSIVE_SITEDESCRIPTION_LABEL"
					filter="string"
					showon="logoFile:"
				/>
				<field
					name="templateFavicon"
					type="media"
					default=""
					label="TPL_XCLUSIVE_FAVICON_LABEL"
					description="TPL_XCLUSIVE_FAVICON_DESC"
				/>
				<field
					name="ogImage"
					type="media"
					default="images/gallery1/06-xclusive-impressie8.jpg"
					label="TPL_XCLUSIVE_OGIMAGE_LABEL"
					description="TPL_XCLUSIVE_OGIMAGE_DESC"
				/>
			</fieldset>
			<fieldset name="layout" label="TPL_XCLUSIVE_FIELDSET_LAYOUT">
				<field
					name="sidebarLeftWidth"
					type="list"
					default="4"
					label="TPL_XCLUSIVE_SIDEBAR_LEFT_WIDTH_LABEL"
					validate="options"
					>
					<option value="2">2/12</option>
					<option value="3">3/12</option>
					<option value="4">4/12</option>
					<option value="5">5/12</option>
				</field>
				<field
					name="sidebarRightWidth"
					type="list"
					default="4"
					label="TPL_XCLUSIVE_SIDEBAR_RIGHT_WIDTH_LABEL"
					validate="options"
					>
					<option value="2">2/12</option>
					<option value="3">3/12</option>
					<option value="4">4/12</option>
					<option value="5">5/12</option>
					<option value="6">6/12</option>
				</field>
				<field
					name="frontpageshow"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					default="1"
					label="TPL_XCLUSIVE_FRONTPAGESHOW_LABEL"
					description="TPL_XCLUSIVE_FRONTPAGESHOW_DESC"
					>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="menuslide"
					type="list"
					default="right"
					label="TPL_XCLUSIVE_MENUSLIDE_LABEL"
					description="TPL_XCLUSIVE_MENUSLIDE_DESC"
					validate="options"
					>
					<option value="left">TPL_XCLUSIVE_MENUSLIDE_LEFT</option>
					<option value="right">TPL_XCLUSIVE_MENUSLIDE_RIGHT</option>
					<option value="top">TPL_XCLUSIVE_MENUSLIDE_TOP</option>
					<option value="bottom">TPL_XCLUSIVE_MENUSLIDE_BOTTOM</option>
				</field>
				<field
					name="toTop"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					default="0"
					label="TPL_XCLUSIVE_TOTOP_LABEL"
					>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field
					name="bodyclass"
					type="text"
					default=""
					label="TPL_XCLUSIVE_BODYCLASS_LABEL"
					description="TPL_XCLUSIVE_BODYCLASS_DESC"
					filter="string"
				/>
				<field
					name="copyrightsText"
					type="textarea"
					default=""
					label="TPL_XCLUSIVE_COPYRIGHTS_TEXT_LABEL"
					description="TPL_XCLUSIVE_COPYRIGHTS_TEXT_DESC"
					rows="4"
					filter="safehtml"
				/>
			</fieldset>
			<fieldset name="tracking" label="TPL_XCLUSIVE_FIELDSET_TRACKING">
				<field
					name="gtmId"
					type="text"
					default=""
					label="TPL_XCLUSIVE_GTM_LABEL"
					description="TPL_XCLUSIVE_GTM_DESC"
					hint="GTM-XXXXXXX"
					filter="string"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
